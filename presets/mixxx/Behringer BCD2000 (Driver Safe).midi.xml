<?xml version='1.0' encoding='utf-8'?>
<MixxxMIDIPreset mixxxVersion="2.4.0+" schemaVersion="1">
    <info>
        <name>Behringer BCD2000 (Driver Safe)</name>
        <author>BCD2000 ASIO/MIDI 64-bit Project (based on Golzo mapping)</author>
        <description>Safe Mixxx 2.x MIDI mapping for Behringer BCD2000: prevents startup EQ/Master zero-mute and enables soft-takeover on pots and faders.</description>
        <manual>behringer_b_control_deejay_bcd2000</manual>
    </info>
    <controller id="Behringer BCD2000 MIDI">
